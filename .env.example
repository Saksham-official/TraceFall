# Copy to .env and fill in. Never commit .env.
# SECRET_KEY has no default; the API refuses to start without one.
#   ./scripts/generate-secret.sh >> .env

ENVIRONMENT=development
SECRET_KEY=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

POSTGRES_USER=tracefall
POSTGRES_PASSWORD=tracefall
POSTGRES_DB=tracefall
DATABASE_URL=postgresql+asyncpg://tracefall:tracefall@postgres:5432/tracefall
REDIS_URL=redis://redis:6379/0

# true = query configured blockchain providers (product default)
# Set false explicitly for the deterministic offline fixture walkthrough.
LIVE_MODE=true

# TronGrid answers without a key; measured limit is 3 rps unauthenticated, and it
# suspends the caller for 5s on breach. A key raises this.
TRONGRID_BASE_URL=https://api.trongrid.io
TRONGRID_API_KEY=
TRONGRID_RATE_PER_SECOND=3
ETHERSCAN_BASE_URL=https://api.etherscan.io/api
ETHERSCAN_API_KEY=
ETHERSCAN_RATE_PER_SECOND=4
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com
BLOCKSCOUT_RATE_PER_SECOND=4

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
CACHE_TTL_SECONDS=3600
MAX_TRANSFERS_PER_ADDRESS=10000
MAX_PAGES_PER_FETCH=200
PAGE_SIZE=200

TRACE_MAX_DEPTH=5
TRACE_TAINT_THRESHOLD=0.01
TRACE_EDGE_BUDGET=5000
TRACE_FANOUT_CAP=20
GRAPH_NODE_CAP=500

RISK_CONFIG_PATH=config/risk_weights.yaml
# Curated label datasets, ingested by `tracefall load-labels`.
LABEL_DATA_PATH=data/labels
ML_MODEL_PATH=models/deposit_classifier.txt
LLM_API_KEY=
# Inbound request limiting. Production refuses to start with this false.
RATE_LIMIT_ENABLED=true
# Only enable behind a load balancer that overwrites X-Forwarded-For. In front of one,
# an attacker sets the header themselves and gets a fresh rate-limit bucket per request.
TRUST_PROXY_HEADERS=false

EVIDENCE_STORAGE_PATH=/data/evidence
REPORT_STORAGE_PATH=/data/reports
CORS_ORIGINS=http://localhost
# Set to none when the production SPA and API use different HTTPS sites (for example
# Vercel + Render). Production startup rejects lax/strict because refresh would not survive
# a cross-site browser session. Keep lax for same-origin local development.
REFRESH_COOKIE_SAMESITE=lax

# Vercel build-time variable (frontend only; never put backend secrets here). Set this to
# the public API origin, without /api/v1; the client appends that path itself.
# VITE_API_URL=https://api.example.com
