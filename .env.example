# Copy to .env and fill in. Never commit .env.
# SECRET_KEY has no default; the API refuses to start without one.
#   ./scripts/generate-secret.sh >> .env

ENVIRONMENT=development
SECRET_KEY=

POSTGRES_USER=tracefall
POSTGRES_PASSWORD=tracefall
POSTGRES_DB=tracefall
DATABASE_URL=postgresql+asyncpg://tracefall:tracefall@postgres:5432/tracefall
REDIS_URL=redis://redis:6379/0

# false = serve from the committed fixture cache (demo default, needs no API keys)
LIVE_MODE=false
TRONGRID_API_KEY=
ETHERSCAN_API_KEY=
BLOCKSCOUT_BASE_URL=https://eth.blockscout.com

TRACE_MAX_DEPTH=5
TRACE_TAINT_THRESHOLD=0.01
TRACE_EDGE_BUDGET=5000
TRACE_FANOUT_CAP=20
GRAPH_NODE_CAP=500

RISK_CONFIG_PATH=config/risk_weights.yaml
ML_MODEL_PATH=models/deposit_classifier.txt
LLM_API_KEY=
EVIDENCE_STORAGE_PATH=/data/evidence
CORS_ORIGINS=http://localhost
